{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/forecast-edge/feishu-brief.schema.json",
  "title": "Forecast Edge Feishu scan briefing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "research_date",
    "title",
    "venues",
    "current_position_count",
    "researched_market_count",
    "actionable_recommendation_count",
    "markdown"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "research_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "title": {"type": "string", "pattern": "^forecast-edge 扫描简报 [0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 80},
    "venues": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    },
    "current_position_count": {"type": "integer", "minimum": 0},
    "researched_market_count": {"type": "integer", "minimum": 0},
    "actionable_recommendation_count": {"type": "integer", "minimum": 0},
    "markdown": {"type": "string", "minLength": 100, "maxLength": 28000}
  }
}
