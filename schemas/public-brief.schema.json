{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/forecast-edge/public-brief.schema.json",
  "title": "Forecast Edge Public Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "generated_at",
    "as_of",
    "title",
    "actions"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "brief_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "as_of": { "type": "string", "format": "date-time" },
    "title": { "const": "预测市场研究信号" },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_id",
        "market_name",
        "action",
        "outcome",
        "polymarket_url",
        "link_verified_at",
        "fair_price",
        "current_price",
        "price_gap",
        "confidence",
        "reason",
        "evidence",
        "probability_tree"
      ],
      "properties": {
        "market_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "market_name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "action": { "enum": ["BUY", "ADD", "SELL"] },
        "outcome": { "enum": ["YES", "NO"] },
        "polymarket_url": {
          "type": "string",
          "pattern": "^https://(www\\.)?polymarket\\.com/event/[^\\s]+$"
        },
        "link_verified_at": { "type": "string", "format": "date-time" },
        "fair_price": { "type": "number", "minimum": 0, "maximum": 1 },
        "current_price": { "type": "number", "minimum": 0, "maximum": 1 },
        "price_gap": { "type": "number", "minimum": -1, "maximum": 1 },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "probability_tree": { "$ref": "#/$defs/probabilityTree" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_url",
        "source_title",
        "source_content",
        "probability_impact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "source_title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "source_content": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "probability_impact": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "probabilityTree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": { "$ref": "#/$defs/probabilityNode" }
      }
    },
    "probabilityNode": {
      "oneOf": [
        { "$ref": "#/$defs/estimateNode" },
        { "$ref": "#/$defs/partitionNode" },
        { "$ref": "#/$defs/bayesUpdateNode" },
        { "$ref": "#/$defs/complementNode" }
      ]
    },
    "estimateNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "description", "probability", "evidence_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/treeId" },
        "type": { "const": "estimate" },
        "label": { "$ref": "#/$defs/nodeLabel" },
        "description": { "$ref": "#/$defs/nodeDescription" },
        "probability": { "$ref": "#/$defs/probability" },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "partitionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "description",
        "probability",
        "evidence_refs",
        "branches"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/treeId" },
        "type": { "const": "partition" },
        "label": { "$ref": "#/$defs/nodeLabel" },
        "description": { "$ref": "#/$defs/nodeDescription" },
        "probability": { "$ref": "#/$defs/probability" },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" },
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/partitionBranch" }
        }
      }
    },
    "partitionBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "weight", "evidence_refs", "child"],
      "properties": {
        "id": { "$ref": "#/$defs/treeId" },
        "label": { "$ref": "#/$defs/nodeLabel" },
        "weight": { "$ref": "#/$defs/probability" },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" },
        "child": { "$ref": "#/$defs/probabilityNode" }
      }
    },
    "bayesUpdateNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "description",
        "probability",
        "evidence_refs",
        "prior",
        "updates"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/treeId" },
        "type": { "const": "bayes_update" },
        "label": { "$ref": "#/$defs/nodeLabel" },
        "description": { "$ref": "#/$defs/nodeDescription" },
        "probability": { "$ref": "#/$defs/probability" },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" },
        "prior": { "$ref": "#/$defs/probabilityNode" },
        "updates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bayesEvidenceUpdate" }
        }
      }
    },
    "bayesEvidenceUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "likelihood_if_true",
        "likelihood_if_false",
        "posterior_probability",
        "evidence_refs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/treeId" },
        "label": { "$ref": "#/$defs/nodeLabel" },
        "likelihood_if_true": { "$ref": "#/$defs/probability" },
        "likelihood_if_false": { "$ref": "#/$defs/probability" },
        "posterior_probability": { "$ref": "#/$defs/probability" },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "complementNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "description",
        "probability",
        "evidence_refs",
        "child"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/treeId" },
        "type": { "const": "complement" },
        "label": { "$ref": "#/$defs/nodeLabel" },
        "description": { "$ref": "#/$defs/nodeDescription" },
        "probability": { "$ref": "#/$defs/probability" },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" },
        "child": { "$ref": "#/$defs/probabilityNode" }
      }
    },
    "treeId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
    },
    "nodeLabel": { "type": "string", "minLength": 1, "maxLength": 160 },
    "nodeDescription": { "type": "string", "minLength": 1, "maxLength": 600 },
    "probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/treeId" }
    }
  }
}
