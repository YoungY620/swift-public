{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecast-edge.local/public-signals.schema.json",
  "title": "Forecast Research Public Signals v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "source_report_id",
    "source_report_sha256",
    "generated_at",
    "as_of",
    "title",
    "actions"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "brief_id": { "type": "string", "minLength": 1 },
    "source_report_id": { "type": "string", "minLength": 1 },
    "source_report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "as_of": { "type": "string", "format": "date-time" },
    "title": { "const": "预测市场研究信号" },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_id",
        "market_name",
        "action",
        "outcome",
        "polymarket_url",
        "yes_probability",
        "fair_price",
        "current_price",
        "raw_edge",
        "net_edge",
        "reason",
        "resolution",
        "evidence",
        "probability_tree"
      ],
      "properties": {
        "market_id": { "type": "string", "minLength": 1 },
        "market_name": { "type": "string", "minLength": 1 },
        "action": { "enum": ["BUY", "ADD", "SELL"] },
        "outcome": { "enum": ["YES", "NO"] },
        "polymarket_url": { "type": "string", "pattern": "^https://(www\\.)?polymarket\\.com/event/" },
        "yes_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "fair_price": { "type": "number", "minimum": 0, "maximum": 1 },
        "current_price": { "type": "number", "minimum": 0, "maximum": 1 },
        "raw_edge": { "type": "number", "minimum": -1, "maximum": 1 },
        "net_edge": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
        "resolution": { "$ref": "#/$defs/resolution" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "probability_tree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root"],
          "properties": { "root": { "$ref": "#/$defs/treeNode" } }
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria_text", "yes_condition", "no_condition", "deadline", "resolution_source"],
      "properties": {
        "criteria_text": { "type": "string", "minLength": 1 },
        "yes_condition": { "type": "string", "minLength": 1 },
        "no_condition": { "type": "string", "minLength": 1 },
        "deadline": { "type": ["string", "null"] },
        "resolution_source": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_url", "source_title", "source_content", "probability_impact"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "pattern": "^https://" },
        "source_title": { "type": "string", "minLength": 1 },
        "source_content": { "type": "string", "minLength": 1 },
        "probability_impact": { "type": "string", "minLength": 1 }
      }
    },
    "treeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "reason", "probability", "evidence_ids", "children"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/treeBranch" }
        }
      }
    },
    "treeBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "weight", "weight_reason", "evidence_ids", "node"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "weight_reason": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "node": { "$ref": "#/$defs/treeNode" }
      }
    }
  }
}
