{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecast-edge.local/report.schema.json",
  "title": "Forecast Edge Report v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "portfolio",
    "discovery_audit",
    "current_positions",
    "candidates",
    "actions",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "3.0" },
    "run": { "$ref": "#/$defs/run" },
    "portfolio": { "$ref": "#/$defs/portfolio" },
    "discovery_audit": { "$ref": "#/$defs/discoveryAudit" },
    "current_positions": {
      "type": "array",
      "items": { "$ref": "#/$defs/currentAnalysis" }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateAnalysis" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "summary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "started_at", "completed_at", "data_cutoff", "account", "previous_report_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "data_cutoff": { "type": "string", "format": "date-time" },
        "account": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "adapter", "identifier"],
          "properties": {
            "input": { "type": "string", "minLength": 1 },
            "adapter": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            },
            "identifier": { "type": "string", "minLength": 1 }
          }
        },
        "previous_report_ids": {
          "type": "array",
          "maxItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available_collateral",
        "holdings_liquidation_value",
        "estimated_bankroll",
        "reserve_cash",
        "deployable_cash",
        "allocated_cash",
        "remaining_cash",
        "cold_start",
        "new_position_limit",
        "diversification_summary"
      ],
      "properties": {
        "available_collateral": { "type": "number", "minimum": 0 },
        "holdings_liquidation_value": { "type": "number", "minimum": 0 },
        "estimated_bankroll": { "type": "number", "minimum": 0 },
        "reserve_cash": { "type": "number", "minimum": 0 },
        "deployable_cash": { "type": "number", "minimum": 0 },
        "allocated_cash": { "type": "number", "minimum": 0 },
        "remaining_cash": { "type": "number", "minimum": 0 },
        "cold_start": { "type": "boolean" },
        "new_position_limit": { "type": "integer", "minimum": 0 },
        "diversification_summary": { "type": "string", "minLength": 1 }
      }
    },
    "discoveryAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pagination_completed",
        "fetched_events",
        "excluded_counts",
        "semantically_qualified_events",
        "selected_events",
        "tier_attempts",
        "operation_needs_satisfied",
        "summary"
      ],
      "properties": {
        "pagination_completed": { "type": "boolean" },
        "fetched_events": { "type": "integer", "minimum": 0 },
        "excluded_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "semantically_qualified_events": { "type": "integer", "minimum": 0 },
        "selected_events": { "type": "integer", "minimum": 0 },
        "tier_attempts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["30pp", "20pp", "gt10pp"],
          "properties": {
            "30pp": { "type": "integer", "minimum": 0 },
            "20pp": { "type": "integer", "minimum": 0 },
            "gt10pp": { "type": "integer", "minimum": 0 }
          }
        },
        "operation_needs_satisfied": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event_identifier",
        "multi_market_identifier",
        "instrument_identifier",
        "question",
        "url",
        "outcome",
        "resolution_criteria",
        "end_date"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "event_identifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        },
        "multi_market_identifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        },
        "instrument_identifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        },
        "question": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "outcome": { "enum": ["YES", "NO"] },
        "resolution_criteria": { "type": "string", "minLength": 1 },
        "end_date": { "type": ["string", "null"] }
      }
    },
    "resolutionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "criteria_text",
        "yes_condition",
        "no_condition",
        "deadline",
        "timezone",
        "resolution_source",
        "edge_cases",
        "reason",
        "evidence_ids"
      ],
      "properties": {
        "status": { "const": "PASS" },
        "criteria_text": { "type": "string", "minLength": 1 },
        "yes_condition": { "type": "string", "minLength": 1 },
        "no_condition": { "type": "string", "minLength": 1 },
        "deadline": { "type": ["string", "null"] },
        "timezone": { "type": ["string", "null"] },
        "resolution_source": { "type": "string", "minLength": 1 },
        "edge_cases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1 },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "treeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "reason", "probability", "evidence_ids", "children"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/treeBranch" }
        }
      }
    },
    "treeBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "weight", "weight_reason", "evidence_ids", "node"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "weight_reason": { "type": "string", "minLength": 1 },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" },
        "node": { "$ref": "#/$defs/treeNode" }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_version", "tree_sha256", "root_probability", "node_count", "deepest_level"],
      "properties": {
        "engine_version": { "const": "3.0" },
        "tree_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "root_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "node_count": { "type": "integer", "minimum": 1 },
        "deepest_level": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yes_probability", "model_value", "conclusion", "tree", "calculation"],
      "properties": {
        "yes_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "model_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "conclusion": { "type": "string", "minLength": 1 },
        "tree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root"],
          "properties": { "root": { "$ref": "#/$defs/treeNode" } }
        },
        "calculation": { "$ref": "#/$defs/calculation" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "roles",
        "source_name",
        "source_type",
        "title",
        "url",
        "published_at",
        "retrieved_at",
        "summary",
        "conclusion",
        "factor_id",
        "credibility"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["PROBABILITY", "RESOLUTION"] }
        },
        "source_name": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "published_at": { "type": ["string", "null"] },
        "retrieved_at": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "conclusion": { "type": "string", "minLength": 1 },
        "factor_id": { "type": "string", "minLength": 1 },
        "credibility": { "type": "string", "minLength": 1 },
        "new_since_previous": { "type": "boolean" },
        "impact": { "type": ["object", "null"] }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["held", "shares", "cost_cash"],
      "properties": {
        "held": { "type": "boolean" },
        "shares": { "type": "number", "minimum": 0 },
        "cost_cash": { "type": "number", "minimum": 0 }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "rationale"],
      "properties": {
        "action": { "enum": ["BUY", "ADD", "MAINTAIN", "TRIM", "SELL"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_eligible",
        "exit_eligible",
        "model_value",
        "executable_price",
        "net_edge",
        "raw_edge",
        "minimum_raw_edge",
        "fee_rate",
        "book_timestamp",
        "reason"
      ],
      "properties": {
        "entry_eligible": { "type": "boolean" },
        "exit_eligible": { "type": "boolean" },
        "model_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "executable_price": { "type": "number", "minimum": 0, "maximum": 1 },
        "net_edge": { "type": "number", "minimum": -1, "maximum": 1 },
        "raw_edge": { "type": "number", "minimum": -1, "maximum": 1 },
        "minimum_raw_edge": { "const": 0.1 },
        "fee_rate": { "type": "number", "minimum": 0 },
        "book_timestamp": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "standalone_kelly_cash",
        "orderbook_capacity_cash",
        "portfolio_cash_cap",
        "minimum_order_cash",
        "cash_before",
        "allocated_cash",
        "cash_after",
        "reason"
      ],
      "properties": {
        "priority": { "type": ["integer", "null"], "minimum": 0 },
        "standalone_kelly_cash": { "type": "number", "minimum": 0 },
        "orderbook_capacity_cash": { "type": "number", "minimum": 0 },
        "portfolio_cash_cap": { "type": ["number", "null"], "minimum": 0 },
        "minimum_order_cash": { "type": "number", "minimum": 0 },
        "cash_before": { "type": "number", "minimum": 0 },
        "allocated_cash": { "type": "number", "minimum": 0 },
        "cash_after": { "type": "number", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "shares", "fee_cash"],
      "properties": {
        "price": { "type": "number", "minimum": 0, "maximum": 1 },
        "shares": { "type": "number", "exclusiveMinimum": 0 },
        "fee_cash": { "type": "number", "minimum": 0 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shares",
        "cash_amount",
        "cash_direction",
        "best_price",
        "vwap",
        "effective_unit_price",
        "gross_cash",
        "fee_cash",
        "slippage",
        "net_edge",
        "book_timestamp",
        "fills",
        "source_snapshot_sha256"
      ],
      "properties": {
        "shares": { "type": "number", "exclusiveMinimum": 0 },
        "cash_amount": { "type": "number", "exclusiveMinimum": 0 },
        "cash_direction": { "enum": ["PAY", "RECEIVE"] },
        "best_price": { "type": "number", "minimum": 0, "maximum": 1 },
        "vwap": { "type": "number", "minimum": 0, "maximum": 1 },
        "effective_unit_price": { "type": "number", "minimum": 0, "maximum": 1 },
        "gross_cash": { "type": "number", "minimum": 0 },
        "fee_cash": { "type": "number", "minimum": 0 },
        "slippage": { "type": "number", "minimum": 0 },
        "net_edge": { "type": "number", "minimum": 0, "maximum": 1 },
        "book_timestamp": { "type": "string", "minLength": 1 },
        "fills": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fill" } },
        "source_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "baseAnalysis": {
      "type": "object",
      "required": [
        "market",
        "resolution_review",
        "model",
        "evidence",
        "position",
        "signal",
        "opportunity",
        "allocation"
      ],
      "properties": {
        "market": { "$ref": "#/$defs/market" },
        "resolution_review": { "$ref": "#/$defs/resolutionReview" },
        "model": { "$ref": "#/$defs/model" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "position": { "$ref": "#/$defs/position" },
        "signal": { "$ref": "#/$defs/signal" },
        "opportunity": { "$ref": "#/$defs/opportunity" },
        "allocation": { "$ref": "#/$defs/allocation" }
      }
    },
    "currentAnalysis": {
      "allOf": [
        { "$ref": "#/$defs/baseAnalysis" },
        {
          "type": "object",
          "required": ["comparison"],
          "properties": { "comparison": { "type": ["object", "null"] } }
        }
      ],
      "unevaluatedProperties": false
    },
    "candidateAnalysis": {
      "allOf": [{ "$ref": "#/$defs/baseAnalysis" }],
      "unevaluatedProperties": false
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "market_id",
        "market_question",
        "outcome",
        "recommended_cash",
        "recommended_shares",
        "rationale",
        "public_reason",
        "execution"
      ],
      "properties": {
        "action": { "enum": ["BUY", "ADD", "MAINTAIN", "TRIM", "SELL"] },
        "market_id": { "type": "string", "minLength": 1 },
        "market_question": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["YES", "NO"] },
        "recommended_cash": { "type": "number", "minimum": 0 },
        "recommended_shares": { "type": "number", "minimum": 0 },
        "rationale": { "type": "string", "minLength": 1 },
        "public_reason": { "type": "string", "minLength": 1, "maxLength": 240 },
        "execution": {
          "oneOf": [
            { "$ref": "#/$defs/execution" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
