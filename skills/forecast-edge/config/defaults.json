{
  "schema_version": 1,
  "probability": {
    "max_depth": 64,
    "branch_sum_tolerance": 1e-09
  },
  "kelly": {
    "enabled": true,
    "fraction": 0.5
  },
  "execution": {
    "minimum_edge_retention": 0.7
  },
  "data": {
    "collateral_symbol": "pUSD",
    "discover_collateral_each_scan": true,
    "allow_fixed_legacy_collateral": false
  },
  "reserve": {
    "reference_positions_min": 2,
    "reference_positions_max": 3,
    "default_reference_positions": 2.5,
    "recent_reports": 2
  },
  "scan": {
    "enumerate_active_event_universe": true,
    "active_event_page_size": 100,
    "active_event_safety_limit": 100000,
    "prescreen_event_target": 100,
    "candidate_research_soft_limit": 10,
    "cold_start_new_positions_min": 1,
    "cold_start_new_positions_max": 2,
    "primary_themes": [
      "politics",
      "economics"
    ],
    "secondary_themes": [
      "culture",
      "markets"
    ],
    "excluded_themes": [
      "sports",
      "esports"
    ]
  },
  "report": {
    "language": "zh-CN"
  },
  "portfolio": {
    "require_canonical_account_snapshot": true,
    "allow_nominal_bankroll": false,
    "semantic_correlation": "qualitative",
    "post_allocation_review": true
  }
}
