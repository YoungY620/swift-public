# Copy to a file outside the repository and chmod 600.
POLYMARKET_ACCOUNT=https://polymarket.com/@public-profile
FORECAST_EDGE_RUNNER=your-agent-wrapper
FORECAST_EDGE_OUTPUT_ROOT=$HOME/.forecast-edge-runs

# Optional public brief. The Agent writes a validated candidate JSON here.
# FORECAST_EDGE_PUBLIC_BRIEF_DIR=$HOME/.forecast-edge-runs/public

# Optional: copy validated public data into a GitHub Pages working tree.
# FORECAST_EDGE_SITE_DATA_DIR=/path/to/public-repository/site/data

# Optional: send the validated public brief with any Feishu app bot.
# FORECAST_EDGE_SEND_FEISHU=true
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_RECEIVE_ID=
# FEISHU_RECEIVE_ID_TYPE=chat_id
# FEISHU_EXPECTED_BOT_NAME=
