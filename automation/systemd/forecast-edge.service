[Unit]
Description=Forecast Edge prediction-market scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=FORECAST_EDGE_ENV_FILE=%h/.config/forecast-edge/forecast-edge.env
# Replace %h/prediction-arb with the repository checkout path.
ExecStart=%h/prediction-arb/automation/run_scan.sh
PrivateTmp=true
NoNewPrivileges=true
